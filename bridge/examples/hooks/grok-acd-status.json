{
  "_comment": "Grok type:http only allows https:// URLs. Loopback bridge is plain HTTP, so use type:command + curl. Fail-open if bridge is down.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sS -m 4 -X POST http://127.0.0.1:8787/v1/hooks/grok -H 'Content-Type: application/json' --data-binary @- -o /dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sS -m 4 -X POST http://127.0.0.1:8787/v1/hooks/grok -H 'Content-Type: application/json' --data-binary @- -o /dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sS -m 4 -X POST http://127.0.0.1:8787/v1/hooks/grok -H 'Content-Type: application/json' --data-binary @- -o /dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sS -m 4 -X POST http://127.0.0.1:8787/v1/hooks/grok -H 'Content-Type: application/json' --data-binary @- -o /dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sS -m 4 -X POST http://127.0.0.1:8787/v1/hooks/grok -H 'Content-Type: application/json' --data-binary @- -o /dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sS -m 4 -X POST http://127.0.0.1:8787/v1/hooks/grok -H 'Content-Type: application/json' --data-binary @- -o /dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
