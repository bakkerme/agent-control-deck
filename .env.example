# Copy to .env.local (ignored by Git), or set these in your shell.
# Loaded only by npm run eval:matching; use Settings for desktop credentials.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_PROVIDER=amazon-bedrock/us-east-1

# Used with npm run eval:matching -- --backend bedrock --live
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=ap-southeast-2
BEDROCK_MODEL=global.openai.gpt-6-luna
